DJANGO_ENVIRONMENT=development
DJANGO_LOCAL_DEMO_AUTO_LOGIN=true
# Explicitly enable automatic demo sessions on a hosted presentation instance.
DJANGO_DEMO_AUTO_LOGIN=false
DJANGO_SECRET_KEY=replace-with-a-new-local-signing-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=enginex
POSTGRES_USER=enginex
POSTGRES_PASSWORD=choose-a-local-database-password
POSTGRES_SSLMODE=disable
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.openai.azure.com/openai/v1
AZURE_AI_FOUNDRY_API_KEY=replace-with-container-app-secret
AZURE_AI_FOUNDRY_DEPLOYMENT=your-model-deployment-name
AZURE_AI_FOUNDRY_API_VERSION=v1
AZURE_STORAGE_ACCOUNT_NAME=sastestathonun001
AZURE_STORAGE_ACCOUNT_KEY=replace-with-container-app-secret
AZURE_STORAGE_CONTAINER=storagex
